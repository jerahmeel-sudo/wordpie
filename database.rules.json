{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.child('host').val() === auth.uid && !newData.exists()))",
        "host": {
          ".write": "auth != null && data.val() === auth.uid",
          ".validate": "newData.isString() && (!data.exists() || newData.parent().child('players').child(newData.val()).exists())"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "settings": {
          ".write": "auth != null && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.hasChildren(['timer', 'start', 'judge'])",
          "timer": { ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 300" },
          "start": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{3,6}$/)" },
          "judge": { ".validate": "newData.val() === 'dict' || newData.val() === 'trust'" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "state": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()",
          ".validate": "newData.hasChild('status')",
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'done'" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
